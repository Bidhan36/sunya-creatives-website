---
import Base from '../layouts/Base.astro';
import { site } from '../data/content.js';
---

<Base title="Privacy | Sunya Creatives" description="How Sunya Creatives handles the details you send through this site." path="/privacy/">
  <main id="main" class="pr">
    <h1>Privacy</h1>
    <p>This site has no tracking cookies and no analytics. Music videos play through YouTube's privacy-enhanced player, which loads only when you press Play.</p>
    <p>The enquiry form does not store anything on this site. It opens a ready-written WhatsApp message or email, which you send yourself. We use what you send only to answer your enquiry and do not share or sell it.</p>
    <p>To have your details deleted, message us on WhatsApp at {site.contact.phone}.</p>
    <a href="/">Back to home</a>
  </main>
</Base>

<style>
  .pr { max-width: 62ch; padding: 140px var(--g) 100px; display: flex; flex-direction: column; gap: 18px; font-size: var(--t-md); }
  .pr h1 { font-size: var(--t-lg); font-weight: 500; letter-spacing: -0.03em; }
  .pr a { border-bottom: 1px solid currentColor; align-self: flex-start; }
</style>
